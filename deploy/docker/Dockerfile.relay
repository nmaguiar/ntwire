FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ntwire-relay ./cmd/ntwire-relay
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/ntwire-relay /ntwire-relay
USER nonroot:nonroot
ENTRYPOINT ["/ntwire-relay"]
