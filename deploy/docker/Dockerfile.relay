FROM golang:1.27 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ntwire-relay ./cmd/ntwire-relay
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /src/LICENSE-QUIC-GO /usr/share/licenses/ntwire/LICENSE-QUIC-GO
COPY --from=build /src/LICENSE-QPACK /usr/share/licenses/ntwire/LICENSE-QPACK
COPY --from=build /out/ntwire-relay /ntwire-relay
USER nonroot:nonroot
ENV NTWIRE_LOG_FORMAT=json
ENTRYPOINT ["/ntwire-relay"]
