FROM golang:1.26 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/ntwire ./cmd/ntwire && \
    mkdir /out/state

FROM gcr.io/distroless/static-debian12:nonroot
ENV HOME=/home/nonroot
COPY --from=build /out/ntwire /ntwire
COPY --chown=nonroot:nonroot --from=build /out/state /home/nonroot/.ntwire
USER nonroot:nonroot
VOLUME ["/home/nonroot/.ntwire"]
ENV NTWIRE_LOG_FORMAT=json
ENTRYPOINT ["/ntwire"]
