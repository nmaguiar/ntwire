@echo off
setlocal EnableExtensions
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $bin='ntwire-relay'; $arch=if($env:PROCESSOR_ARCHITECTURE -eq 'ARM64'){'arm64'}else{'amd64'}; $release=Invoke-RestMethod -UseBasicParsing 'https://api.github.com/repos/nmaguiar/ntwire/releases/latest'; $asset=@($release.assets ^| Where-Object {$_.name -match ('^'+[regex]::Escape($bin)+'_v?[^_]+_windows_'+$arch+'\.zip$')})[0]; if($null -eq $asset){throw \"No $bin release asset found for windows/$arch.\"}; $dir=Join-Path $env:LOCALAPPDATA 'ntwire\bin'; New-Item -ItemType Directory -Force -Path $dir ^| Out-Null; $zip=Join-Path $env:TEMP ($bin+'.zip'); Invoke-WebRequest -UseBasicParsing $asset.browser_download_url -OutFile $zip; Expand-Archive -LiteralPath $zip -DestinationPath $dir -Force; Remove-Item -Force $zip; Write-Host \"Installed $bin.exe to $dir. Add this folder to PATH to run it anywhere.\""
